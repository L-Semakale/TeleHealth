generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(uuid())
  fullName         String         @map("full_name")
  phoneNumber      String         @unique @map("phone_number")
  hashedPassword   String         @map("hashed_password")
  role             String         @default("patient")
  anonymousId      String         @unique @map("anonymous_id")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  symptomReports   SymptomReport[]
  patientConsults  Consultation[] @relation("PatientConsultations")
  providerConsults Consultation[] @relation("ProviderConsultations")
  messages         Message[]

  @@map("users")
}

model SymptomReport {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  symptoms        String
  durationDays    Int            @map("duration_days")
  additionalNotes String?        @map("additional_notes")
  submittedAt     DateTime       @default(now()) @map("submitted_at")
  user            User           @relation(fields: [userId], references: [id])
  triageResults   TriageResult[]
  consultations   Consultation[]

  @@map("symptom_reports")
}

model TriageResult {
  id              String        @id @default(uuid())
  reportId        String        @map("report_id")
  classification  String
  confidenceScore Float         @map("confidence_score")
  createdAt       DateTime      @default(now()) @map("created_at")
  report          SymptomReport @relation(fields: [reportId], references: [id])

  @@map("triage_results")
}

model Consultation {
  id         String        @id @default(uuid())
  patientId  String        @map("patient_id")
  providerId String        @map("provider_id")
  reportId   String?       @map("report_id")
  status     String        @default("open")
  startedAt  DateTime      @default(now()) @map("started_at")
  closedAt   DateTime?     @map("closed_at")
  patient    User          @relation("PatientConsultations", fields: [patientId], references: [id])
  provider   User          @relation("ProviderConsultations", fields: [providerId], references: [id])
  report     SymptomReport? @relation(fields: [reportId], references: [id])
  messages   Message[]
  referrals  Referral[]

  @@map("consultations")
}

model Message {
  id             String       @id @default(uuid())
  consultationId String       @map("consultation_id")
  senderId       String       @map("sender_id")
  encryptedBody  String       @map("encrypted_body")
  sentAt         DateTime     @default(now()) @map("sent_at")
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])

  @@map("messages")
}

model Referral {
  id             String       @id @default(uuid())
  consultationId String       @map("consultation_id")
  facilityId     String       @map("facility_id")
  notes          String?
  issuedAt       DateTime     @default(now()) @map("issued_at")
  viewedAt       DateTime?    @map("viewed_at")
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  facility       Facility     @relation(fields: [facilityId], references: [id])

  @@map("referrals")
}

model Facility {
  id        String     @id @default(uuid())
  name      String
  address   String
  phone     String?
  latitude  Float?
  longitude Float?
  isActive  Boolean    @default(true) @map("is_active")
  referrals Referral[]

  @@map("facilities")
}

model RoleChangeAudit {
  id           String   @id @default(uuid())
  targetUserId String   @map("target_user_id")
  adminUserId  String   @map("admin_user_id")
  oldRole      String   @map("old_role")
  newRole      String   @map("new_role")
  changedAt    DateTime @default(now()) @map("changed_at")

  @@map("role_change_audits")
}
