generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(uuid()) @db.Uuid
  fullName         String         @map("full_name") @db.VarChar(255)
  phoneNumber      String         @unique @map("phone_number") @db.VarChar(20)
  hashedPassword   String         @map("hashed_password")
  role             String         @default("patient") @db.VarChar(20)
  anonymousId      String         @unique @map("anonymous_id") @db.VarChar(50)
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  symptomReports   SymptomReport[]
  patientConsults  Consultation[] @relation("PatientConsultations")
  providerConsults Consultation[] @relation("ProviderConsultations")
  messages         Message[]

  @@map("users")
}

model SymptomReport {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  symptoms       String[]
  durationDays   Int            @map("duration_days")
  additionalNotes String?       @map("additional_notes")
  submittedAt    DateTime       @default(now()) @map("submitted_at")
  user           User           @relation(fields: [userId], references: [id])
  triageResults  TriageResult[]
  consultations  Consultation[]

  @@map("symptom_reports")
}

model TriageResult {
  id              String       @id @default(uuid()) @db.Uuid
  reportId        String       @map("report_id") @db.Uuid
  classification  String       @db.VarChar(20)
  confidenceScore Float        @map("confidence_score")
  createdAt       DateTime     @default(now()) @map("created_at")
  report          SymptomReport @relation(fields: [reportId], references: [id])

  @@map("triage_results")
}

model Consultation {
  id         String       @id @default(uuid()) @db.Uuid
  patientId  String       @map("patient_id") @db.Uuid
  providerId String       @map("provider_id") @db.Uuid
  reportId   String?      @map("report_id") @db.Uuid
  status     String       @default("open") @db.VarChar(20)
  startedAt  DateTime     @default(now()) @map("started_at")
  closedAt   DateTime?    @map("closed_at")
  patient    User         @relation("PatientConsultations", fields: [patientId], references: [id])
  provider   User         @relation("ProviderConsultations", fields: [providerId], references: [id])
  report     SymptomReport? @relation(fields: [reportId], references: [id])
  messages   Message[]
  referrals  Referral[]

  @@map("consultations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  consultationId String       @map("consultation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  encryptedBody  String       @map("encrypted_body")
  sentAt         DateTime     @default(now()) @map("sent_at")
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])

  @@map("messages")
}

model Referral {
  id             String       @id @default(uuid()) @db.Uuid
  consultationId String       @map("consultation_id") @db.Uuid
  facilityId     String       @map("facility_id") @db.Uuid
  notes          String?
  issuedAt       DateTime     @default(now()) @map("issued_at")
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  facility       Facility     @relation(fields: [facilityId], references: [id])

  @@map("referrals")
}

model Facility {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @db.VarChar(255)
  address   String
  phone     String?    @db.VarChar(20)
  latitude  Float?
  longitude Float?
  isActive  Boolean    @default(true) @map("is_active")
  referrals Referral[]

  @@map("facilities")
}

model RoleChangeAudit {
  id            String   @id @default(uuid()) @db.Uuid
  targetUserId  String   @map("target_user_id") @db.Uuid
  adminUserId   String   @map("admin_user_id") @db.Uuid
  oldRole       String   @map("old_role") @db.VarChar(20)
  newRole       String   @map("new_role") @db.VarChar(20)
  changedAt     DateTime @default(now()) @map("changed_at")

  @@map("role_change_audits")
}
