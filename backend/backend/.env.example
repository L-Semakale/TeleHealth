# Local (no Docker) — SQLite (default for npm run dev)
DATABASE_URL=file:./prisma/dev.db
REDIS_URL=memory

# PostgreSQL (optional) — uncomment and run prisma db push against postgres
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/telemedicine
# REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-minimum-32-characters-secret
AES_ENCRYPTION_KEY=12345678901234567890123456789012
ML_SERVICE_URL=http://localhost:5001
PORT=3000
