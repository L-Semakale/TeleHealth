{
  "name": "telemedicine-backend",
  "version": "1.0.0",
  "description": "Telemedicine backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "cross-env DATABASE_URL=file:./prisma/dev.db REDIS_URL=memory node --watch src/server.js",
    "start": "cross-env DATABASE_URL=file:./prisma/dev.db REDIS_URL=memory node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "lint": "echo \"Add your linter config\""
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "axios": "^1.9.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.0",
    "prisma": "^6.8.2"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
